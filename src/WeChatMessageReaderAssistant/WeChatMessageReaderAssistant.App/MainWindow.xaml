<Window x:Class="WeChatMessageReaderAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信消息朗读助手" Height="620" Width="880"
        WindowStartupLocation="CenterScreen"
        MinHeight="520" MinWidth="820"
        FocusManager.FocusedElement="{Binding ElementName=SpeechBackendComboBox}"
        AutomationProperties.Name="微信消息朗读助手主窗口"
        AutomationProperties.HelpText="这是微信消息朗读助手主窗口。日常只显示朗读方式、语速、音量、保存和退出。测试诊断工具默认收起，可在故障诊断和测试工具里展开。">
    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Alt" Command="{Binding SpeakCommand}" />
        <KeyBinding Key="V" Modifiers="Alt" Command="{Binding VoiceMessageCommand}" />
        <KeyBinding Key="S" Modifiers="Alt" Command="{Binding StopCommand}" />
        <KeyBinding Key="A" Modifiers="Alt" Command="{Binding RequestNotificationAccessCommand}" />
        <KeyBinding Key="L" Modifiers="Alt" Command="{Binding ToggleNotificationListeningCommand}" />
        <KeyBinding Key="T" Modifiers="Alt" Command="{Binding TestNotificationParseCommand}" />
        <KeyBinding Key="W" Modifiers="Alt" Command="{Binding DetectWeChatWindowCommand}" />
        <KeyBinding Key="B" Modifiers="Alt" Command="{Binding DetectMsaaWeChatWindowCommand}" />
        <KeyBinding Key="M" Modifiers="Alt" Command="{Binding ToggleWeChatChatMonitorCommand}" />
        <KeyBinding Key="E" Modifiers="Alt" Command="{Binding EngineDiagnosticCommand}" />
        <KeyBinding Key="C" Modifiers="Alt" Command="{Binding CopyTroubleshootingReportCommand}" />
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding ExitCommand}" />
    </Window.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="微信消息朗读助手" FontSize="26" FontWeight="Bold"
                           AutomationProperties.Name="微信消息朗读助手" />
                <TextBlock Margin="0,8,0,0" Foreground="#333" FontSize="14" TextWrapping="Wrap"
                           Text="日常设置界面已简化。启动后会自动隐藏到通知区域，并继续监听当前微信聊天里的新文字消息。正常使用时只需要设置朗读方式、语速和音量。" />
                <TextBlock Margin="0,8,0,0" Foreground="#333" FontSize="14" TextWrapping="Wrap"
                           Text="如果软件出问题，请展开下面的“故障诊断和测试工具”，里面可以测试朗读、检测微信窗口、做朗读引擎诊断，也可以按“复制排查信息”把当前运行情况直接复制到剪贴板。真正退出请按 Ctrl+Q 或点退出程序。" />
            </StackPanel>

            <GroupBox Grid.Row="1" Header="常用设置" Padding="12" Margin="0,0,0,14"
                      AutomationProperties.Name="常用设置区域">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Target="{Binding ElementName=SpeechBackendComboBox}"
                           Content="朗读方式：" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SpeechBackendComboBox" Height="34" Width="380"
                              HorizontalAlignment="Left" TabIndex="0"
                              IsEnabled="True" SelectionChanged="SpeechBackendComboBox_SelectionChanged"
                              AutomationProperties.Name="朗读方式选择框"
                              AutomationProperties.HelpText="请选择朗读方式。默认使用自动检测当前读屏；会按争渡、保益、NVDA 的顺序检测当前可用接口；都不可用时，会自动回退 Windows SAPI 系统语音库。">
                        <ComboBoxItem Tag="AUTO" Content="自动检测当前读屏，失败自动回退 SAPI" IsSelected="True" />
                        <ComboBoxItem Tag="ZDSRAPI" Content="争渡官方接口，失败自动回退 SAPI" />
                        <ComboBoxItem Tag="BAOYI" Content="保益三方朗读服务，失败自动回退 SAPI" />
                        <ComboBoxItem Tag="NVDA" Content="NVDA &#x5B98;&#x65B9;&#x63A7;&#x5236;&#x63A5;&#x53E3;&#xFF0C;&#x5931;&#x8D25;&#x81EA;&#x52A8;&#x56DE;&#x9000; SAPI" />
                        <ComboBoxItem Tag="SAPI" Content="Windows SAPI 系统语音库，稳定保底" />
                    </ComboBox>

                    <Label Grid.Row="1" Grid.Column="0" Target="{Binding ElementName=RateSlider}"
                           Content="语速：" Margin="0,16,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                        <Slider x:Name="RateSlider" Width="300" Minimum="-10" Maximum="10" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="True" TabIndex="1"
                                AutomationProperties.Name="语速滑块"
                                AutomationProperties.HelpText="调整朗读语速。Windows SAPI 可由这里调节；保益和 NVDA 会尽量交给读屏接口朗读，实际语速通常请在读屏软件本身调整；争渡官方接口的实际语速请在争渡软件本身调整。使用左右方向键调整，范围负十到十，默认零。" />
                        <TextBlock x:Name="RateValueText" Width="100" Margin="12,0,0,0" VerticalAlignment="Center" Text="当前 0"
                                   AutomationProperties.Name="当前语速值 0" />
                    </StackPanel>

                    <Label Grid.Row="2" Grid.Column="0" Target="{Binding ElementName=VolumeSlider}"
                           Content="音量：" Margin="0,16,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                        <Slider x:Name="VolumeSlider" Width="300" Minimum="0" Maximum="100" Value="100"
                                TickFrequency="5" IsSnapToTickEnabled="True" TabIndex="2"
                                AutomationProperties.Name="音量滑块"
                                AutomationProperties.HelpText="调整朗读音量。使用左右方向键调整，范围零到一百，默认一百。" />
                        <TextBlock x:Name="VolumeValueText" Width="100" Margin="12,0,0,0" VerticalAlignment="Center" Text="当前 100"
                                   AutomationProperties.Name="当前音量值 100" />
                    </StackPanel>

                    <Label Grid.Row="3" Grid.Column="0" Target="{Binding ElementName=GlobalMonitorHotkeyComboBox}"
                           Content="全局快捷键：" Margin="0,16,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="GlobalMonitorHotkeyComboBox" Height="34" Width="380"
                              Margin="0,16,0,0" HorizontalAlignment="Left" TabIndex="3"
                              AutomationProperties.Name="全局暂停和恢复微信监听快捷键"
                              AutomationProperties.HelpText="选择全局快捷键。即使主窗口隐藏到通知区域，也可以用这组快捷键暂停或恢复微信监听。">
                        <ComboBoxItem Tag="Ctrl+Alt+M" Content="Ctrl 加 Alt 加 M，暂停或恢复微信监听" IsSelected="True" />
                        <ComboBoxItem Tag="Ctrl+Shift+M" Content="Ctrl 加 Shift 加 M，暂停或恢复微信监听" />
                        <ComboBoxItem Tag="Alt+Shift+M" Content="Alt 加 Shift 加 M，暂停或恢复微信监听" />
                        <ComboBoxItem Tag="Ctrl+Alt+W" Content="Ctrl 加 Alt 加 W，暂停或恢复微信监听" />
                        <ComboBoxItem Tag="Off" Content="关闭全局暂停和恢复快捷键" />
                    </ComboBox>

                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Left">
                        <Button x:Name="SaveSettingsButton" Width="150" Height="38" Margin="0,0,12,0" TabIndex="4"
                                IsDefault="True"
                                Content="保存设置" Click="SaveSettingsButton_Click"
                                AutomationProperties.Name="保存设置"
                                AutomationProperties.HelpText="保存朗读方式、语速、音量、全局快捷键和微信检测间隔。" />
                        <Button x:Name="ExitButton" Width="150" Height="38" Margin="0,0,12,0" TabIndex="5"
                                Content="退出程序(_Q)" Click="ExitButton_Click"
                                AutomationProperties.Name="退出程序"
                                AutomationProperties.HelpText="真正退出程序。快捷键 Ctrl 加 Q。" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <Expander Grid.Row="2" Header="故障诊断和测试工具，默认收起，需要排查问题时按回车展开" IsExpanded="False" Margin="0,0,0,14"
                      AutomationProperties.Name="故障诊断和测试工具"
                      AutomationProperties.HelpText="这里放着测试朗读、微信窗口检测、MSAA诊断、朗读引擎诊断、通知记录等工具。平时不用展开。">
                <StackPanel Margin="0,10,0,0">
                    <GroupBox Header="测试朗读" Padding="12" Margin="0,0,0,12"
                              AutomationProperties.Name="测试朗读区域">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Target="{Binding ElementName=MessageTextBox}"
                                   Content="朗读内容：" VerticalAlignment="Top" FontWeight="SemiBold" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="MessageTextBox" Height="100"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     TabIndex="20"
                                     AutomationProperties.Name="朗读内容编辑框"
                                     AutomationProperties.HelpText="请输入要测试朗读的文字。按 Alt 加 R 可以朗读当前内容。"
                                     Text="张三说，您好，这是一条测试微信文字消息。李四给您发来一条语音消息。" />
                            <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" HorizontalAlignment="Left">
                                <Button x:Name="SpeakButton" Width="150" Height="38" Margin="0,0,12,8" TabIndex="21"
                                        Content="测试朗读(_R)" Click="SpeakButton_Click"
                                        AutomationProperties.Name="测试朗读"
                                        AutomationProperties.HelpText="朗读编辑框中的测试文字。快捷键 Alt 加 R。" />
                                <Button x:Name="VoiceMessageButton" Width="190" Height="38" Margin="0,0,12,8" TabIndex="22"
                                        Content="语音消息提示(_V)" Click="VoiceMessageButton_Click"
                                        AutomationProperties.Name="测试语音消息提示"
                                        AutomationProperties.HelpText="朗读一条语音消息提示。快捷键 Alt 加 V。" />
                                <Button x:Name="StopButton" Width="130" Height="38" Margin="0,0,12,8" TabIndex="23"
                                        Content="停止朗读(_S)" Click="StopButton_Click"
                                        AutomationProperties.Name="停止朗读"
                                        AutomationProperties.HelpText="停止当前朗读。快捷键 Alt 加 S。也可以按 Control 键停止正在朗读的内容。" />
                            </WrapPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="微信监控、通知监听和诊断" Padding="12" Margin="0,0,0,12"
                              AutomationProperties.Name="微信监控通知监听和诊断区域">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                                <TextBlock TextWrapping="Wrap" Foreground="#333"
                                           Text="正式朗读以 UIA 监控当前微信聊天窗口为主，启动后会自动开始监控。下面的 Windows 通知监听和 MSAA 扫描只保留为辅助测试、诊断功能。" />
                                <CheckBox x:Name="OnlyWeChatCheckBox" Margin="0,10,0,0" IsChecked="True" TabIndex="30"
                                          Content="只记录微信通知，忽略其它应用通知"
                                          AutomationProperties.Name="只记录微信通知"
                                          AutomationProperties.HelpText="默认开启。开启后通知记录里只显示疑似微信通知，避免无关系统通知干扰。" />
                                <CheckBox x:Name="AutoReadWeChatCheckBox" Margin="0,8,0,0" IsChecked="True" TabIndex="31"
                                          Content="捕获微信通知后自动朗读"
                                          AutomationProperties.Name="捕获微信通知后自动朗读"
                                          AutomationProperties.HelpText="默认开启。开启后捕获疑似微信通知时自动朗读文字消息或语音消息提示。" />
                            </StackPanel>

                            <Label Grid.Row="1" Grid.Column="0" Target="{Binding ElementName=MonitorIntervalSlider}"
                                   Content="检测间隔：" Margin="0,16,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                                <Slider x:Name="MonitorIntervalSlider" Width="280" Minimum="300" Maximum="1000" Value="500"
                                        TickFrequency="50" IsSnapToTickEnabled="True" TabIndex="32"
                                        AutomationProperties.Name="微信检测间隔滑块"
                                        AutomationProperties.HelpText="调整微信聊天检测间隔。数值越小反应越快，CPU占用可能略高；数值越大更省资源。建议默认五百毫秒。" />
                                <TextBlock x:Name="MonitorIntervalValueText" Width="140" Margin="12,0,0,0" VerticalAlignment="Center" Text="当前 500 毫秒"
                                           AutomationProperties.Name="当前微信检测间隔 500 毫秒" />
                            </StackPanel>

                            <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" HorizontalAlignment="Left">
                                <Button x:Name="RequestAccessButton" Width="170" Height="38" Margin="0,0,12,8" TabIndex="33"
                                        Content="申请通知权限(_A)" Click="RequestAccessButton_Click"
                                        AutomationProperties.Name="申请通知监听权限"
                                        AutomationProperties.HelpText="向 Windows 申请读取系统通知的权限。快捷键 Alt 加 A。" />
                                <Button x:Name="ToggleListeningButton" Width="170" Height="38" Margin="0,0,12,8" TabIndex="34"
                                        Content="开始监听(_L)" Click="ToggleListeningButton_Click"
                                        AutomationProperties.Name="开始或停止通知监听"
                                        AutomationProperties.HelpText="开始或停止监听 Windows 通知。快捷键 Alt 加 L。" />
                                <Button x:Name="TestParseButton" Width="170" Height="38" Margin="0,0,12,8" TabIndex="35"
                                        Content="测试通知解析(_T)" Click="TestParseButton_Click"
                                        AutomationProperties.Name="测试通知解析"
                                        AutomationProperties.HelpText="不用真实微信通知，模拟一条微信文字消息并朗读。快捷键 Alt 加 T。" />
                                <Button x:Name="DetectWeChatWindowButton" Width="170" Height="38" Margin="0,0,12,8" TabIndex="36"
                                        Content="检测微信窗口(_W)" Click="DetectWeChatWindowButton_Click"
                                        AutomationProperties.Name="检测微信窗口"
                                        AutomationProperties.HelpText="检测当前打开的电脑版微信窗口，并把可见文字写入通知记录。快捷键 Alt 加 W。" />
                                <Button x:Name="DetectMsaaWeChatWindowButton" Width="190" Height="38" Margin="0,0,12,8" TabIndex="37"
                                        Content="MSAA Scan WeChat(_B)" Click="DetectMsaaWeChatWindowButton_Click"
                                        AutomationProperties.Name="MSAA Scan WeChat Window"
                                        AutomationProperties.HelpText="使用 MSAA 或 IAccessible 扫描微信窗口的无障碍对象，辅助诊断是否能看到聊天文字消息正文。快捷键 Alt 加 B。" />
                                <Button x:Name="ToggleWeChatMonitorButton" Width="190" Height="38" Margin="0,0,12,8" TabIndex="38"
                                        Content="监控当前聊天(_M)" Click="ToggleWeChatMonitorButton_Click"
                                        AutomationProperties.Name="监控当前微信聊天"
                                        AutomationProperties.HelpText="开始或停止监控当前打开的微信聊天窗口。开始时会忽略已有消息，只朗读之后检测到的新消息。快捷键 Alt 加 M。" />
                                <Button x:Name="EngineDiagnosticButton" Width="170" Height="38" Margin="0,0,12,8" TabIndex="39"
                                        Content="朗读引擎诊断(_E)" Command="{Binding EngineDiagnosticCommand}"
                                        AutomationProperties.Name="朗读引擎诊断"
                                        AutomationProperties.HelpText="检查当前选择的朗读引擎和实际使用的朗读通道，并把结果写入通知记录。快捷键 Alt 加 E。" />
                                <Button x:Name="CopyTroubleshootingReportButton" Width="210" Height="38" Margin="0,0,12,8" TabIndex="40"
                                        Content="复制排查信息(_C)" Command="{Binding CopyTroubleshootingReportCommand}"
                                        AutomationProperties.Name="复制排查信息给开发者"
                                        AutomationProperties.HelpText="自动汇总当前运行状态、配置、朗读引擎、微信窗口检测、通知记录、错误报告和运行日志，并复制到剪贴板。快捷键 Alt 加 C。" />
                            </WrapPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="通知记录和错误报告" Padding="12" AutomationProperties.Name="通知记录和错误报告区域">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Target="{Binding ElementName=NotificationLogTextBox}"
                                   Content="通知记录：" VerticalAlignment="Top" FontWeight="SemiBold" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NotificationLogTextBox"
                                     Height="160" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="True" TabIndex="41"
                                     AutomationProperties.Name="通知记录"
                                     AutomationProperties.HelpText="这里显示最近的运行记录、微信监控结果和诊断信息。可以按 Ctrl 加 A 全选，再按 Ctrl 加 C 复制。"
                                     Text="尚未记录信息。" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#333"
                                       Text="如果程序报错，也可以把这个文件发给开发者：C:\微信消息朗读助手绿色版\错误报告.txt" />
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </Expander>

            <GroupBox Grid.Row="3" Header="当前状态" Padding="12" AutomationProperties.Name="当前状态区域">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Target="{Binding ElementName=StatusTextBox}"
                           Content="当前状态：" VerticalAlignment="Top" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" x:Name="StatusTextBox"
                             TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             TabIndex="50" MinHeight="70"
                             AutomationProperties.Name="当前状态"
                             AutomationProperties.HelpText="这里显示程序当前状态和操作结果。"
                             AutomationProperties.LiveSetting="Assertive"
                             Text="准备就绪。软件会自动监控当前微信聊天，只朗读新文字消息。" />
                </Grid>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Window>

